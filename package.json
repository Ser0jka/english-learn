{
  "name": "lexi-english",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.mjs *.ts *.json index.html README.md"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
