{
  "name": "lexi-english",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server.mjs --dev",
    "build": "npm run typecheck && vite build && node scripts/build-pwa.mjs",
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.mjs *.ts *.json index.html README.md",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@types/compression": "^1.8.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
