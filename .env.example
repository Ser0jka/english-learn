# Optional. Keep actual values in .env.local (ignored by Git) or server environment.
# Without a key, the built-in vocabulary, illustrations, expressions and reading work.
LEXI_API_KEY=
LEXI_API_BASE=https://api.openai.com/v1
LEXI_MODEL=gpt-4o-mini

# Optional image-generation overrides. Default: use the key and base URL above.
LEXI_IMAGE_MODEL=gpt-image-1
# LEXI_IMAGE_API_KEY=
# LEXI_IMAGE_API_BASE=https://api.openai.com/v1

PORT=5173

# Groq text generation (does not generate images):
# LEXI_API_BASE=https://api.groq.com/openai/v1
# LEXI_MODEL=openai/gpt-oss-120b
# Supply your Groq key as server-only LEXI_API_KEY.
# Image generation needs a separate supported provider/key.
